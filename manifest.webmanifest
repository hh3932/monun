{
  "name": "모눈 시트",
  "short_name": "모눈",
  "description": "칸과 서식에 집중한 표 프로그램",
  "lang": "ko",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#F7F8FA",
  "theme_color": "#2E5BD0",
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [{
        "name": "file",
        "accept": [".monun", ".xlsx", ".json", "application/json", "application/octet-stream", "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", "text/plain"]
      }]
    }
  },
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
